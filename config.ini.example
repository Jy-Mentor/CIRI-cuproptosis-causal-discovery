# 配置文件示例
# 复制此文件为 config.ini 并根据您的环境修改路径

[paths]
# MGLTools 路径配置
# Windows 用户请取消注释并修改以下路径：
mgltools_python = C:\Program Files (x86)\MGLTools-1.5.7\python.exe
mgltools_prepare_receptor = C:\Program Files (x86)\MGLTools-1.5.7\Lib\site-packages\AutoDockTools\Utilities24\prepare_receptor4.py
mgltools_prepare_ligand = C:\Program Files (x86)\MGLTools-1.5.7\Lib\site-packages\AutoDockTools\Utilities24\prepare_ligand4.py

# Linux/macOS 用户请取消注释并修改以下路径：
# mgltools_python = /usr/local/bin/python
# mgltools_prepare_receptor = /usr/local/lib/python3.8/site-packages/AutoDockTools/Utilities24/prepare_receptor4.py
# mgltools_prepare_ligand = /usr/local/lib/python3.8/site-packages/AutoDockTools/Utilities24/prepare_ligand4.py

[docking]
# AutoDock Vina 路径
vina_exe = C:\Program Files (x86)\The Scripps Research Institute\Vina\vina.exe

# P2Rank 路径（可选，如果未安装可留空）
p2rank_dir = C:\p2rank_2.4.1